        "jacket|color|black",
        "building|color|white",
        "door|color|white"
      ],
      "exploratory_groups": []
    }
  },
  "preprocessing": {
    "mechanism": {
      "do_image_splitting": false,
      "resize": "384x384 square",
      "visual_tokens": 81,
      "grid": "9x9"
    },
    "behavior_validation": {
      "do_image_splitting_options": [
        false,
        true
      ],
      "splitting_blocks": 17,
      "splitting_visual_tokens": 1377
    }
  },
  "stages": {
    "S0": {
      "module": "model.model.vision_model.post_layernorm",
      "position": "output",
      "shape": "27x27x1152"
    },
    "S1": {
      "module": "model.model.connector",
      "position": "output",
      "shape": "9x9x2048"
    },
    "S2": {
      "module": "model.model.text_model.layers[6]",
      "position": "input",
      "note": "~25% depth"
    },
    "S3": {
      "module": "model.model.text_model.layers[12]",
      "position": "input",
      "note": "~50% depth"
    },
    "S4": {
      "module": "model.model.text_model.layers[18]",
      "position": "input",
      "note": "~75% depth"
    }
  },
  "scoring": {
    "prompt_template": "{question}\\nAnswer with a single word, yes or no.",
    "candidate_margin": "logsumexp(log p(yes variants)) - logsumexp(log p(no variants))",
    "generation": "greedy, max_new_tokens=4, first yes/no token"
  },
  "region_controls": {
    "spatial": [
      "target",
      "reference",
      "irrelevant",
      "background",
      "full_visual_block"
    ],
    "semantic": [
      "target",
      "irrelevant",
      "background",
      "full_visual_block"
    ]
  },
  "frozen_at": "2026-11-07",
  "analysis": {
    "test_pairs_per_group": 20,
    "min_abs_delta_for_recovery": 0.5,
    "bootstrap_samples": 2000,
    "cluster": "pair_id; image_id sensitivity",
    "primary_metric": "candidate margin m=log p(yes)-log p(no)"
  },
  "experiments": {
    "E2_regions": {
      "stages": [
        "S0",
        "S1",
        "S6",
        "S12",
        "S18"
      ],
